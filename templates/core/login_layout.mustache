{{!
    @template theme_gflacso4academic/core/login_layout

    Keep Academic's existing full-page background and right-aligned login in
    Moodle 5.3, which otherwise inherits Boost's new split-screen layout.
    Moodle 5.1 does not use this partial and retains its inherited login layout.
    Main content stays dynamic, including authentication and MFA forms.

    Example context (json):
    {"output": {"main_content": "<h1>Login form</h1>"}}
}}
<div id="page-content" class="row g-0">
    <div id="region-main-box" class="col-12">
        <div id="region-main" class="col-12 h-100">
            <div class="login-wrapper">
                <div class="login-container">
                    {{{ output.main_content }}}
                </div>
            </div>
        </div>
    </div>
</div>
